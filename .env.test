# =============================================================
# IronID — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ironid
POSTGRES_USER=ironid
POSTGRES_PASSWORD=ironid_dev_password
DATABASE_URL=postgresql+asyncpg://ironid:ironid_dev_password@localhost:5432/ironid

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ironid_redis_password
REDIS_URL=redis://:ironid_redis_password@localhost:6379/0

# --- Clerk (Authentication) ---
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# --- PayPal ---
PAYPAL_CLIENT_ID=AXxx...
PAYPAL_CLIENT_SECRET=EKxx...
PAYPAL_WEBHOOK_ID=WH-xxx...          # ID du webhook enregistré dans le dashboard PayPal
PAYPAL_MODE=sandbox                  # sandbox | live

# PayPal Plan IDs (créer via l'API ou le dashboard PayPal)
PAYPAL_PLAN_INDIVIDUAL_MONTHLY=P-xxx...
PAYPAL_PLAN_INDIVIDUAL_YEARLY=P-xxx...
PAYPAL_PLAN_STUDIO_MONTHLY=P-xxx...
PAYPAL_PLAN_STUDIO_YEARLY=P-xxx...
PAYPAL_PLAN_ENTERPRISE_MONTHLY=P-xxx...
PAYPAL_PLAN_ENTERPRISE_YEARLY=P-xxx...

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=ironid-files
R2_PUBLIC_URL=https://r2.ironid.io

# --- Resend (Email) ---
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@ironid.io

# --- Sentry ---
SENTRY_DSN=https://...@sentry.io/...

# --- PostHog ---
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com

# --- App Config ---
APP_ENV=development
APP_SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Override for test
REDIS_URL=redis://localhost:6379/1
