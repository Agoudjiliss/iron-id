{
  "name": "@ironid/sdk",
  "version": "1.0.0",
  "description": "Official JavaScript/TypeScript SDK for IronID — C2PA-powered content provenance.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev":   "tsup src/index.ts --format cjs,esm --dts --watch",
    "test":  "vitest run",
    "lint":  "tsc --noEmit"
  },
  "keywords": ["c2pa", "content-authenticity", "digital-provenance", "ironid"],
  "license": "MIT",
  "devDependencies": {
    "tsup":    "^8.0.0",
    "typescript": "^5.4.0",
    "vitest":  "^1.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
